{
  "name": "silatacademy_mvp",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "@hawkzone_labs/testkit": "^0.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "i": "^0.3.7",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.3",
    "npm": "^11.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "globalSetup": "./tests/globalSetup.js",
    "globalTeardown": "./tests/globalTeardown.js"
  }
}
